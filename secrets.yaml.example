wifi_ssid: "your-network"
wifi_password: "your-wifi-password"

# Home Assistant API encryption key (32-byte base64).
# Generate one at https://esphome.io/components/api.html or with:
#   openssl rand -base64 32
api_key: "REPLACE_ME_BASE64_KEY"

# Password for OTA updates.
ota_password: "your-ota-password"
